{
  "name": "goteams-client-web",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "lint": "eslint src vite.config.ts",
    "lint:fix": "eslint src vite.config.ts --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,css}\" vite.config.ts eslint.config.js env.d.ts index.html",
    "format:check": "prettier --check \"src/**/*.{vue,ts,tsx,css}\" vite.config.ts eslint.config.js env.d.ts index.html",
    "typecheck": "vue-tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test": "npm run typecheck && npm run i18n:check",
    "build": "npm run typecheck && vite build --mode production",
    "build:prod": "npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "ant-design-vue": "^4.2.6",
    "dayjs": "1.11.21",
    "markdown-it": "^14.3.0",
    "pinia": "^2.3.0",
    "vditor": "^3.11.3",
    "vue": "^3.5.13",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@intlify/eslint-plugin-vue-i18n": "~4.5.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.67.0",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
